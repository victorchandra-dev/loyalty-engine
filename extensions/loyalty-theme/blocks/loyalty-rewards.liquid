{{ 'loyalty-theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Anonymous by design: this block shows program-level config only (tiers,
  redemptions, earn rules). The classic Liquid storefront has no signed
  customer-identity channel, so personalized points/tier/XP are NOT shown here.
  For per-customer data use the New Customer Accounts UI extension or a Hydrogen
  storefront. See extensions/loyalty-theme/README.md (audit M1).

  Set "Loyalty engine URL" in the block settings — there is no hard-coded
  fallback host; the widget fails closed when it is empty (audit M3).
{%- endcomment -%}

<div
  class="adf-loyalty-block"
  data-adf-loyalty="section"
  data-engine-url="{{ block.settings.engine_url | escape }}"
  data-shop-domain="{{ shop.permanent_domain | escape }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-show-redemptions="{{ block.settings.show_redemptions }}"
>
  <div class="adf-loyalty-card">
    <p class="adf-loyalty-eyebrow">Ama Da Flow</p>
    <h2 class="adf-loyalty-heading">{{ block.settings.heading }}</h2>
    <p class="adf-loyalty-copy">Loading rewards...</p>
  </div>
</div>

<script src="{{ 'loyalty-theme.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Loyalty rewards",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "engine_url",
      "label": "Loyalty engine URL",
      "info": "Public URL of the loyalty engine (e.g. https://your-engine.example.com). Required — the widget shows nothing if empty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rewards"
    },
    {
      "type": "checkbox",
      "id": "show_redemptions",
      "label": "Show redemptions",
      "default": true
    }
  ]
}
{% endschema %}
