# Shopify app credentials — get from Partners dashboard > App setup
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL where this app is hosted (no trailing slash)
# Local dev: use Cloudflare Tunnel or `shopify app dev` URL
SHOPIFY_APP_URL=https://amadaflow-loyalty-201907146826.asia-southeast1.run.app

# Comma-separated Shopify API scopes (must match shopify.app.toml)
SCOPES=read_customers,write_customers,read_orders,read_discounts,write_discounts,read_metaobjects,write_metaobjects,read_metaobject_definitions,write_metaobject_definitions

# Optional: override the shop domain for local dev (e.g. your-store.myshopify.com)
SHOP_CUSTOM_DOMAIN=

# Shared secret between this engine and the Hydrogen storefront.
# Must match LOYALTY_ENGINE_SHARED_SECRET in the storefront's env.
# Generate with: openssl rand -hex 32
LOYALTY_ENGINE_SHARED_SECRET=

# Per-customer token signing secret (distinct from the shared secret above).
# The storefront mints a short-lived x-loyalty-customer-token bound to the
# authenticated customer's GID; the engine verifies it on /api/redeem and
# /api/attribute-referral to prevent acting on arbitrary customers (IDOR).
# Must match LOYALTY_CUSTOMER_TOKEN_SECRET in the storefront's env.
# Generate with: openssl rand -hex 32
LOYALTY_CUSTOMER_TOKEN_SECRET=

# Prisma database URL — PostgreSQL (schema provider is "postgresql").
# Local dev: postgresql://postgres:postgres@localhost:5432/loyaltyflow?schema=public
# Production (Cloud Run): the DATABASE_URL secret in Secret Manager (Cloud SQL private IP)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyaltyflow?schema=public
