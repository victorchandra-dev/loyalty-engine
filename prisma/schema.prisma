generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per webhook event already handled (topic + resource GID), so
// Shopify's duplicate and retried deliveries award or debit points once.
// ponytail: never pruned; it grows one tiny row per order/refund. Prune by
// createdAt if it ever matters.
model ProcessedWebhook {
  key       String   @id
  createdAt DateTime @default(now())
}

// Every points change (and reward use), appended after the Shopify balance
// write succeeds. Feeds a customer's history, the results page and Klaviyo.
// type: order | signup | referral | refund | redeem | reward_used | manual.
model PointsEvent {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  type       String
  points     Int
  balance    Int
  orderId    String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([shop, customerId, createdAt])
  @@index([shop, createdAt])
}
